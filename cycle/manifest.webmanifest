{
  "name": "orOS Cycle",
  "short_name": "Cycle",
  "description": "orOS Cycle: the orOS app on its own. Works offline, no cookies, no tracking; encrypted sync only if you turn it on.",
  "id": "/cycle/solo.html",
  "start_url": "/cycle/solo.html",
  "scope": "/cycle/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14120d",
  "theme_color": "#1b1a18",
  "icons": [
    {
      "src": "/icons/solo/cycle.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/cycle-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/cycle-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/cycle-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities"
  ],
  "shortcuts": [
    {
      "name": "Log today",
      "short_name": "Log today",
      "url": "/cycle/solo.html?do=today",
      "icons": [
        {
          "src": "/icons/solo/cycle-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/cycle/solo.html?file-open=cycle",
      "accept": {
        "application/x-oros-cycle": [
          ".oroscycle"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/cycle/solo.html?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/x-oros-cycle",
            ".oroscycle"
          ]
        }
      ]
    }
  }
}
