{
  "name": "orOS Maps",
  "short_name": "Maps",
  "description": "orOS Maps: the orOS app on its own. Works offline, no cookies, no tracking; encrypted sync only if you turn it on.",
  "id": "/maps/solo.html",
  "start_url": "/maps/solo.html",
  "scope": "/maps/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14120d",
  "theme_color": "#1b1a18",
  "icons": [
    {
      "src": "/icons/solo/maps.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/maps-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/maps-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/maps-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities"
  ],
  "shortcuts": [
    {
      "name": "My location",
      "short_name": "My location",
      "url": "/maps/solo.html?do=locate",
      "icons": [
        {
          "src": "/icons/solo/maps-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Where I parked",
      "short_name": "Where I parked",
      "url": "/maps/solo.html?do=park",
      "icons": [
        {
          "src": "/icons/solo/maps-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/maps/solo.html?file-open=maps",
      "accept": {
        "application/gpx+xml": [
          ".gpx"
        ],
        "application/vnd.google-earth.kml+xml": [
          ".kml"
        ],
        "application/geo+json": [
          ".geojson"
        ],
        "application/x-oros-map": [
          ".orosmap"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/maps/solo.html?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/gpx+xml",
            ".gpx",
            "application/vnd.google-earth.kml+xml",
            ".kml",
            "application/geo+json",
            ".geojson",
            "application/x-oros-map",
            ".orosmap"
          ]
        }
      ]
    }
  }
}
