{
  "name": "orOS Contacts",
  "short_name": "Contacts",
  "description": "orOS Contacts: the orOS app on its own. Works offline, no cookies, no tracking; encrypted sync only if you turn it on.",
  "id": "/contacts/solo.html",
  "start_url": "/contacts/solo.html",
  "scope": "/contacts/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14120d",
  "theme_color": "#1b1a18",
  "icons": [
    {
      "src": "/icons/solo/contacts.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/contacts-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/contacts-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/contacts-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities"
  ],
  "shortcuts": [
    {
      "name": "New contact",
      "short_name": "New contact",
      "url": "/contacts/solo.html?do=new",
      "icons": [
        {
          "src": "/icons/solo/contacts-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/contacts/solo.html?file-open=contacts",
      "accept": {
        "text/vcard": [
          ".vcf"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/contacts/solo.html?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/vcard",
            ".vcf"
          ]
        }
      ]
    }
  }
}
