{
  "name": "orOS Stock",
  "short_name": "Stock",
  "description": "orOS Stock: the orOS app on its own. Works offline, no cookies, no tracking; encrypted sync only if you turn it on.",
  "id": "/stock/solo.html",
  "start_url": "/stock/solo.html",
  "scope": "/stock/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14120d",
  "theme_color": "#1b1a18",
  "icons": [
    {
      "src": "/icons/solo/stock.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/stock-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/stock-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/stock-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities"
  ],
  "shortcuts": [
    {
      "name": "To reorder",
      "short_name": "To reorder",
      "url": "/stock/solo.html?do=reorder",
      "icons": [
        {
          "src": "/icons/solo/stock-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Sales reports",
      "short_name": "Sales reports",
      "url": "/stock/solo.html?do=reports",
      "icons": [
        {
          "src": "/icons/solo/stock-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/stock/solo.html?file-open=stock",
      "accept": {
        "application/x-oros-stock": [
          ".orosstock"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/stock/solo.html?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/x-oros-stock",
            ".orosstock"
          ]
        }
      ]
    }
  }
}
