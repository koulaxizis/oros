{
  "name": "orOS Spreadsheet",
  "short_name": "Spreadsheet",
  "description": "orOS Spreadsheet: the orOS app on its own. Works offline, no cookies, no tracking; encrypted sync only if you turn it on.",
  "id": "/spreadsheet/solo.html",
  "start_url": "/spreadsheet/solo.html",
  "scope": "/spreadsheet/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14120d",
  "theme_color": "#1b1a18",
  "icons": [
    {
      "src": "/icons/solo/spreadsheet.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/spreadsheet-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/spreadsheet-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/spreadsheet-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities"
  ],
  "shortcuts": [
    {
      "name": "New sheet",
      "short_name": "New sheet",
      "url": "/spreadsheet/solo.html?do=new",
      "icons": [
        {
          "src": "/icons/solo/spreadsheet-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/spreadsheet/solo.html?file-open=spreadsheet",
      "accept": {
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "application/vnd.ms-excel": [
          ".xls"
        ],
        "application/vnd.oasis.opendocument.spreadsheet": [
          ".ods"
        ],
        "text/csv": [
          ".csv"
        ],
        "application/x-oros-sheet": [
          ".orossheet"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/spreadsheet/solo.html?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".xlsx",
            "application/vnd.ms-excel",
            ".xls",
            "application/vnd.oasis.opendocument.spreadsheet",
            ".ods",
            "text/csv",
            ".csv",
            "application/x-oros-sheet",
            ".orossheet"
          ]
        }
      ]
    }
  }
}
