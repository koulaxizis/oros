{
  "name": "orOS Diary",
  "short_name": "Diary",
  "description": "orOS Diary: the orOS app on its own. Works offline, no cookies, no tracking; encrypted sync only if you turn it on.",
  "id": "/diary/solo.html",
  "start_url": "/diary/solo.html",
  "scope": "/diary/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14120d",
  "theme_color": "#1b1a18",
  "icons": [
    {
      "src": "/icons/solo/diary.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/diary-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/diary-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/diary-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities"
  ],
  "shortcuts": [
    {
      "name": "Write today's sentence",
      "short_name": "Write today's sentence",
      "url": "/diary/solo.html?do=write",
      "icons": [
        {
          "src": "/icons/solo/diary-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/diary/solo.html?file-open=diary",
      "accept": {
        "application/x-oros-diary": [
          ".orosdiary"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/diary/solo.html?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/x-oros-diary",
            ".orosdiary"
          ]
        }
      ]
    }
  }
}
