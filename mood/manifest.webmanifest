{
  "name": "orOS Mood",
  "short_name": "Mood",
  "description": "orOS Mood: the orOS app on its own. Works offline, no cookies, no tracking; encrypted sync only if you turn it on.",
  "id": "/mood/solo.html",
  "start_url": "/mood/solo.html",
  "scope": "/mood/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14120d",
  "theme_color": "#1b1a18",
  "icons": [
    {
      "src": "/icons/solo/mood.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/mood-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/mood-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/mood-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities"
  ],
  "shortcuts": [
    {
      "name": "Log my mood",
      "short_name": "Log my mood",
      "url": "/mood/solo.html?do=log",
      "icons": [
        {
          "src": "/icons/solo/mood-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/mood/solo.html?file-open=mood",
      "accept": {
        "application/x-oros-mood": [
          ".orosmood"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/mood/solo.html?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/x-oros-mood",
            ".orosmood"
          ]
        }
      ]
    }
  }
}
