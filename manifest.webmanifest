{
  "name": "orOS",
  "short_name": "orOS",
  "description": "A static operating system in your browser. Works offline, no cookies, no tracking.",
  "start_url": "/?source=pwa",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14120d",
  "theme_color": "#1b1a18",
  "version": "1.78.00",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {"action":"/?share-target","method":"POST","enctype":"multipart/form-data","params":{"title":"title","text":"text","url":"url","files":[{"name":"files","accept":["application/vnd.openxmlformats-officedocument.wordprocessingml.document",".docx","application/vnd.oasis.opendocument.text",".odt","application/rtf",".rtf","text/markdown",".md",".markdown","text/plain",".txt","application/x-oros-doc",".orosdoc","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",".xlsx","application/vnd.ms-excel",".xls","application/vnd.oasis.opendocument.spreadsheet",".ods","text/csv",".csv","application/vnd.openxmlformats-officedocument.presentationml.presentation",".pptx","application/x-oros-design",".orosdesign","application/x-oros-slides",".orosslides","application/x-oros-layout",".oroslayout","application/vnd.scribus",".sla","application/vnd.adobe.indesign-idml-package",".idml","text/x-opml",".opml","application/x-freemind",".mm","application/vnd.xmind.workbook",".xmind","application/x-gedcom",".ged",".gedcom","audio/x-rtttl",".rtttl",".rtx","image/png",".png","image/jpeg",".jpg",".jpeg","image/webp",".webp","image/gif",".gif","image/bmp",".bmp","image/avif",".avif","image/vnd.adobe.photoshop",".psd","image/openraster",".ora","application/epub+zip",".epub","application/pdf",".pdf","application/x-fictionbook+xml",".fb2","application/vnd.comicbook+zip",".cbz","video/mp4",".mp4",".m4v","video/webm",".webm","video/quicktime",".mov","text/tab-separated-values",".tsv","application/gpx+xml",".gpx","application/vnd.google-earth.kml+xml",".kml","application/geo+json",".geojson","text/calendar",".ics","text/vcard",".vcf"]}]}},
  "file_handlers": [
    {"action":"/?file-open=writer","accept":{"application/vnd.openxmlformats-officedocument.wordprocessingml.document":[".docx"],"application/vnd.oasis.opendocument.text":[".odt"],"application/rtf":[".rtf"],"text/markdown":[".md",".markdown"],"text/plain":[".txt"],"application/x-oros-doc":[".orosdoc"]}},
    {"action":"/?file-open=spreadsheet","accept":{"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet":[".xlsx"],"application/vnd.ms-excel":[".xls"],"application/vnd.oasis.opendocument.spreadsheet":[".ods"],"text/csv":[".csv"]}},
    {"action":"/?file-open=atelier","accept":{"application/vnd.openxmlformats-officedocument.presentationml.presentation":[".pptx"],"application/x-oros-design":[".orosdesign"]}},
    {"action":"/?file-open=slides","accept":{"application/x-oros-slides":[".orosslides"]}},
    {"action":"/?file-open=layout","accept":{"application/x-oros-layout":[".oroslayout"],"application/vnd.scribus":[".sla"],"application/vnd.adobe.indesign-idml-package":[".idml"]}},
    {"action":"/?file-open=feeds","accept":{"text/x-opml":[".opml"]}},
    {"action":"/?file-open=mindmap","accept":{"application/x-freemind":[".mm"],"application/vnd.xmind.workbook":[".xmind"]}},
    {"action":"/?file-open=familytree","accept":{"application/x-gedcom":[".ged",".gedcom"]}},
    {"action":"/?file-open=ringtones","accept":{"audio/x-rtttl":[".rtttl",".rtx"]}},
    {"action":"/?file-open=photolab","accept":{"image/png":[".png"],"image/jpeg":[".jpg",".jpeg"],"image/webp":[".webp"],"image/gif":[".gif"],"image/bmp":[".bmp"],"image/avif":[".avif"],"image/vnd.adobe.photoshop":[".psd"],"image/openraster":[".ora"]}},
    {"action":"/?file-open=library","accept":{"application/epub+zip":[".epub"],"application/pdf":[".pdf"],"application/x-fictionbook+xml":[".fb2"],"application/vnd.comicbook+zip":[".cbz"]}},
    {"action":"/?file-open=montage","accept":{"video/mp4":[".mp4",".m4v"],"video/webm":[".webm"],"video/quicktime":[".mov"]}},
    {"action":"/?file-open=texttools","accept":{"text/tab-separated-values":[".tsv"]}},
    {"action":"/?file-open=maps","accept":{"application/gpx+xml":[".gpx"],"application/vnd.google-earth.kml+xml":[".kml"],"application/geo+json":[".geojson"]}},
    {"action":"/?file-open=calendar","accept":{"text/calendar":[".ics"]}},
    {"action":"/?file-open=contacts","accept":{"text/vcard":[".vcf"]}}
  ],
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "utilities"],
  "shortcuts": [
    { "name": "Notes",      "short_name": "Notes",      "url": "/?open=notes",      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "To-Do",      "short_name": "To-Do",      "url": "/?open=todo",       "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Calendar",   "short_name": "Calendar",   "url": "/?open=calendar",   "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Calculator", "short_name": "Calculator", "url": "/?open=calculator", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}