{
  "name": "orOS Mind Map",
  "short_name": "Mind Map",
  "description": "orOS Mind Map: the orOS app on its own. Works offline, no cookies, no tracking; encrypted sync only if you turn it on.",
  "id": "/mindmap/solo.html",
  "start_url": "/mindmap/solo.html",
  "scope": "/mindmap/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14120d",
  "theme_color": "#1b1a18",
  "icons": [
    {
      "src": "/icons/solo/mindmap.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/mindmap-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/mindmap-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/solo/mindmap-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities"
  ],
  "shortcuts": [
    {
      "name": "New map",
      "short_name": "New map",
      "url": "/mindmap/solo.html?do=new",
      "icons": [
        {
          "src": "/icons/solo/mindmap-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/mindmap/solo.html?file-open=mindmap",
      "accept": {
        "application/x-freemind": [
          ".mm"
        ],
        "application/vnd.xmind.workbook": [
          ".xmind"
        ],
        "text/x-opml": [
          ".opml"
        ],
        "text/markdown": [
          ".md",
          ".markdown"
        ],
        "text/plain": [
          ".txt"
        ],
        "application/x-oros-mind": [
          ".orosmind"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/mindmap/solo.html?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/x-freemind",
            ".mm",
            "application/vnd.xmind.workbook",
            ".xmind",
            "text/x-opml",
            ".opml",
            "text/markdown",
            ".md",
            ".markdown",
            "text/plain",
            ".txt",
            "application/x-oros-mind",
            ".orosmind"
          ]
        }
      ]
    }
  }
}
